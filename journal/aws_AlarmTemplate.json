{
  "AlarmName": "Your-Alarm-Name",
  "AlarmDescription": "Alert when estimated charges exceed $X",
  "ActionsEnabled": true,
  "AlarmActions": ["arn:aws:sns:us-east-1:YOUR_ACCOUNT_ID:YOUR_TOPIC_NAME"],
  "MetricName": "EstimatedCharges",
  "Namespace": "AWS/Billing",
  "Statistic": "Maximum",
  "Dimensions": [
    {
      "Name": "Currency",
      "Value": "USD"
    }
  ],
  "Period": 21600,
  "EvaluationPeriods": 1,
  "Threshold": 10.0,
  "ComparisonOperator": "GreaterThanThreshold"
}